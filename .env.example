# Better Auth Configuration
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000,https://www.cadivity.com,https://cadivity.com"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample-123456.region.aws.neon.tech/neondb?sslmode=require"

# Email Services (Resend & SMTP)
RESEND_API_KEY="re_sample_api_key_here"
RESEND_FROM="Cadivity <hello@cadivity.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"

# Security & Rate Limiting (Arcjet)
ARCJET_KEY="ajkey_sample_key_here"

# Razorpay Payment Gateway
# Set RAZORPAY_MODE to 'test' or 'live'
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="your_sample_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_sample_webhook_secret"

# Public client-side keys (safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_sample_key_id"
