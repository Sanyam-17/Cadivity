# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# debug & temporary scripts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
test-*.js
test-*.ts
check-*.js
temp_*.sql
temp_*.js

# env files (allow .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/lib/generated/prisma
/lib/generated/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# AI Agent & local dev tooling
.agents/
.claude/
.superpowers/
skills-lock.json

# Screenshots & visual test assets
screenshots/
